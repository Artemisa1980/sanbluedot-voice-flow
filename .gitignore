__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
build/
dist/
.build/
*.egg-info/

# Handoff state and the folder adapter. The shared contract excludes relays and
# folder CLAUDE.md files from every commit; ignoring them enforces that by default.
relay-log.md
CLAUDE.md

# Private user data and local configuration
audio/
recordings/
transcripts/
user-data/
config.local.*
*.local.json
*.local.md
*.local.txt
# Whole directories of personal working material, not just single files. The suffix
# alone matched `x.local.txt` but nothing inside `corpus.local/`, so a directory of
# practice texts would have been committed.
*.local/
*.jsonl
*-audio/
practice/
*.corrupt-*
.*.lock
.env
.env.*
# Recordings outside the named folders, and the files that carry the speaker's own
# sentences: a distilled `Modelfile` holds real pairs, and an export written inside the
# project would otherwise be one `git add -A` from the repository.
*.wav
*.m4a
*.mp3
*.aiff
*.caf
Modelfile*
*.export.json

# Model weights and packaged binaries. `models/` matches a directory and nothing else,
# so the worktree that reaches the weights through a symlink named `models` was left
# untracked-but-not-ignored, one `git add -A` away from committing a path that only
# exists on this machine. The bare name covers both shapes.
models
models/
*.bin
*.gguf
*.mlmodelc/
*.safetensors
*.onnx
*.mlpackage/
*.mlmodel
src-tauri/binaries/
# Cargo writes the Windows build here. `binaries/` alone covered the bundled sidecars and
# left the compiler's own output, which is where the gigabytes are, untracked but not
# ignored — one `git add -A` from entering the repository.
target/

# Xcode's per-user state. The project file itself is tracked: it is the build that
# carries App Intents metadata, and `scripts/generate-xcodeproj.py` regenerates it.
xcuserdata/
*.xcuserdatad/
DerivedData/

# Platform metadata
.DS_Store
Thumbs.db
